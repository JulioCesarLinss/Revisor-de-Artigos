# Modelo do .env.local (desenvolvimento local).
# Copie este arquivo como ".env.local" e preencha os valores.
# O .env.local NUNCA vai para o git (o .gitignore bloqueia .env*); este modelo vai, sem valores.
# Na produção, os mesmos nomes ficam em Vercel → Settings → Environment Variables.

# --- Firebase (público: vai para o navegador; a proteção vem das regras do Firestore) ---
# Onde pegar: Firebase → Configurações do projeto → Seus apps → app web → Configuração do SDK.
# Sem estas variáveis, o app roda em modo local (sem conta real e sem Gemini).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Gemini (SEGREDO: só no servidor, nunca com prefixo VITE_) ---
# Onde pegar: Google AI Studio → API Keys. Lida pelo "bun run api" (local) e pela Vercel.
GEMINI_API_KEY=

# --- Portas locais (opcionais) ---
# PORT=5173      # front (bun run dev)
# API_PORT=8787  # servidor local da API (bun run api)
