{
  "name": "normareview-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "api": "bun server/index.ts",
    "test": "bun test",
    "test:carga": "bun scripts/teste-carga.ts --perfil normal",
    "test:carga:pico": "bun scripts/teste-carga.ts --perfil pico",
    "test:carga:estresse": "bun scripts/teste-carga.ts --perfil estresse",
    "smells": "bun scripts/detectar-test-smells.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:pdf": "playwright test --reporter=json > .resultados-e2e.json && node scripts/relatorio-pdf.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "firebase": "^13.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.2.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.5"
  }
}
